{
  "name": "longhorn-mcp",
  "version": "0.1.1",
  "description": "MCP server for the Longhorn distributed storage manager API",
  "mcpName": "io.github.rafaelgaspar/longhorn-mcp",
  "type": "module",
  "license": "MIT",
  "bin": {
    "longhorn-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
